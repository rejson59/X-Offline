# X-Offline — skopiuj do .env i dostosuj
# --- serwer proxy (server/index.js) ---
PORT=8787
HOST=0.0.0.0
# Jak długo trzymać odpowiedzi X w pamięci (ms). X dawkuje te endpointy, więc 5 min to rozsądne.
CACHE_TTL=300000
# Niektóre sieci/regiony potrzebują innego User-Agent, żeby syndykacja odpowiadała.
# UPSTREAM_UA=Mozilla/5.0 ...
# MAX_MEDIA_BYTES=67108864

# ----------------
# --- aplikacja webowa (apps/web) ---
# Adres proxy wpięty na sztywno (i tak można go nadpisać w Ustawieniach).
# W dev wystarczy zostawić pusto: Vite proxy przekaże /api na 127.0.0.1:8787.
# VITE_XOFFLE_PROXY=https://xoffline-proxy.twoja-nazwa.workers.dev
